---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Pixscaler"
  description="Get in touch with Pixscaler by email for questions about the tool, privacy, or the project."
>
  <article class="contact-page section">
    <div class="container container--narrow prose">
      <h1>Contact</h1>
      <p>
        For questions about Pixscaler, this website, or the privacy policy, you can reach the
        maintainer at:
      </p>
      <p>
        <a href="mailto:contact@pixscaler.com">contact@pixscaler.com</a>
      </p>
      <p>
        Bug reports and code contributions are also welcome on
        <a href="https://github.com/27bhd/Pixscaler" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>.
      </p>

      <hr class="divider" />
      <p>
        <a href="/">Back to Pixscaler →</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .section { padding-block: 3.5rem; }
</style>
