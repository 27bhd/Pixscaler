---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title="Blog — Image Optimization Guides and Web Performance Tips"
  description="Practical guides on image compression, WebP and AVIF conversion, Core Web Vitals, and making your website load faster. Written plainly, without the hype."
>
  <section class="blog-index section">
    <div class="container">
      <header class="blog-index__header">
        <h1 class="blog-index__title">Guides and tips</h1>
        <p class="blog-index__sub">
          Practical articles on image optimization, next-gen formats, web performance,
          and getting the most out of Pixscaler.
        </p>
      </header>

      {posts.length === 0 ? (
        <p class="blog-index__empty">No posts yet. Check back soon.</p>
      ) : (
        <ul class="post-list" role="list">
          {posts.map((post) => (
            <li class="post-card" role="listitem">
              <article>
                <div class="post-card__meta">
                  <time datetime={post.data.pubDate.toISOString()} class="post-card__date">
                    {formatDate(post.data.pubDate)}
                  </time>
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <h2 class="post-card__title">
                  <a href={`/blog/${post.id}`} class="post-card__link">
                    {post.data.title}
                  </a>
                </h2>
                <p class="post-card__desc">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="post-card__read-more" aria-hidden="true">
                  Read article →
                </a>
              </article>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-block: 3.5rem; }

  .blog-index__header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--surface-border);
    padding-bottom: 2rem;
  }

  .blog-index__title { margin-bottom: 0.75rem; }

  .blog-index__sub {
    color: var(--text-muted);
    max-width: 60ch;
    font-size: 1rem;
  }

  .blog-index__empty { color: var(--text-muted); font-style: italic; }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    padding-block: 2rem;
    border-bottom: 1px solid var(--surface-border);
  }

  .post-card:last-child { border-bottom: none; }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  .post-card__date {
    font-size: 0.82rem;
    color: var(--text-faint);
  }

  .post-card__title {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .post-card__link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post-card__link:hover { color: var(--color-deep-teal); }

  .post-card__desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 0.75rem;
    max-width: 68ch;
  }

  .post-card__read-more {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-medium-teal);
    text-decoration: none;
  }

  .post-card__read-more:hover { color: var(--color-deep-teal); }
</style>
