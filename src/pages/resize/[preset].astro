---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageResizer from '../../components/ImageResizer';
import presets from '../../data/presets.json';

export function getStaticPaths() {
  return presets.map((preset) => ({
    params: { preset: preset.slug },
    props: { preset },
  }));
}

interface Preset {
  slug: string;
  label: string;
  width: number;
  height: number;
  aspectRatio: string;
  format: 'webp' | 'avif' | 'jpeg' | 'png';
  platform: string;
  description: string;
  keywords: string;
  explainerHeading?: string;
  explainerParagraphs?: string[];
  explainerBullets?: string[];
}

const { preset } = Astro.props as { preset: Preset };

const metaSuffix = ` Pixscaler: ${preset.width}x${preset.height}px ${preset.format.toUpperCase()}, local in your browser.`;
const maxMeta = 300;
let metaDescription = `${preset.description.trim()}${metaSuffix}`;
if (metaDescription.length > maxMeta) {
  const budget = maxMeta - metaSuffix.length - 1;
  let head = preset.description.trim().slice(0, Math.max(48, budget - 1)).trimEnd();
  const sp = head.lastIndexOf(' ');
  if (sp > 48) head = head.slice(0, sp);
  metaDescription = `${head}…${metaSuffix}`;
}
---

<BaseLayout
  title={`Resize image for ${preset.label} | Pixscaler`}
  description={metaDescription}
>
  <!-- ── Preset header ── -->
  <section class="preset-header">
    <div class="container container--narrow">
      <a href="/resize" class="preset-header__back">← All presets</a>
      <span class="preset-header__platform">{preset.platform}</span>
      <h1 class="preset-header__title">Resize image for {preset.label}</h1>
      <p class="preset-header__desc">{preset.description}</p>

      <dl class="preset-specs">
        <div class="preset-spec">
          <dt>Dimensions</dt>
          <dd>{preset.width} × {preset.height} px</dd>
        </div>
        <div class="preset-spec">
          <dt>Aspect ratio</dt>
          <dd>{preset.aspectRatio}</dd>
        </div>
        <div class="preset-spec">
          <dt>Recommended format</dt>
          <dd>{preset.format.toUpperCase()}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ── Tool ── -->
  <section class="section">
    <div class="container">
      <ImageResizer
        client:load
        presetWidth={preset.width}
        presetHeight={preset.height}
        presetFormat={preset.format}
        isPresetWorkspace={true}
      />
    </div>
  </section>

  <!-- ── Why this preset ── -->
  <section class="preset-explainer section">
    <div class="container container--narrow prose">
      <h2>{preset.explainerHeading ?? `Why ${preset.label} dimensions matter`}</h2>
      {preset.explainerParagraphs && preset.explainerParagraphs.length > 0 ? (
        preset.explainerParagraphs.map((p) => <p>{p}</p>)
      ) : (
        <>
          <p>
            When you upload an image to {preset.platform} that is the wrong size, the platform
            either crops it automatically or stretches it to fill the frame. Both outcomes
            reduce image quality and can make your content look unprofessional.
          </p>
          <p>
            Using {preset.width} x {preset.height} pixels helps your image fill the
            display area correctly across desktop and mobile. The {preset.format.toUpperCase()}
            format is a practical default here because it balances quality
            and file size for this use case, keeping pages fast without obvious compression
            artefacts at normal viewing distances.
          </p>
        </>
      )}
      <h3>Tips before you upload</h3>
      <ul>
        {preset.explainerBullets && preset.explainerBullets.length > 0 ? (
          preset.explainerBullets.map((item) => <li>{item}</li>)
        ) : (
          <>
            <li>Check that any text or key content sits inside the safe zone, away from edges that may be cropped on smaller screens.</li>
            <li>The tool above outputs exactly {preset.width} x {preset.height} pixels. If your source photo has a different aspect ratio, it will be stretched or squeezed to fit that frame. Plan your composition accordingly.</li>
            <li>Use the quality slider and the before/after file sizes in the list to tune compression before you download.</li>
            <li>After downloading, confirm the result looks correct before publishing.</li>
          </>
        )}
      </ul>
      <p>
        All compression happens locally in your browser. Your image files never leave your computer.
      </p>
      <p>
        <a href="/blog">Read image sizing guides on the blog</a>
        {' · '}
        <a href="/tool">Open the full resizer workspace</a>
        {' · '}
        <a href="/">About Pixscaler</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-block: 3rem; }

  .preset-header {
    padding-block: 3rem 2rem;
    border-bottom: 1px solid var(--surface-border);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-mint-green) 10%, var(--surface-base)) 0%,
      var(--surface-base) 70%
    );
  }

  .preset-header__back {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 1rem;
    transition: color var(--transition-fast);
  }

  .preset-header__back:hover { color: var(--color-deep-teal); }

  .preset-header__platform {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-medium-teal);
    margin-bottom: 0.5rem;
  }

  .preset-header__title {
    margin-bottom: 0.85rem;
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  }

  .preset-header__desc {
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }

  .preset-specs {
    display: flex;
    gap: 0.75rem 2rem;
    flex-wrap: wrap;
  }

  .preset-spec dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  .preset-spec dd {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .preset-explainer { border-top: 1px solid var(--surface-border); }
</style>
